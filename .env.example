# Application
APP_NAME=FileScanner
DEBUG=True
API_V1_PREFIX=/api

# Database (PostgreSQL default; supports SQLite for offline dev e.g. sqlite:///./filescanner.db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/filescanner_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
ASYNC_SCAN_ENABLED=False

# ClamAV Antivirus Daemon
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_SOCKET_TIMEOUT=15

# Scanner Limits
MAX_FILE_SIZE_MB=100
MAX_ZIP_EXTRACT_SIZE_MB=500
MAX_ZIP_FILES=1000
MAX_NESTED_ZIP_DEPTH=3

# URL Scanner Controls
URL_SCAN_TIMEOUT=10
URL_MAX_REDIRECTS=5
URL_MAX_CONTENT_SIZE_MB=5

# Storage Directories
UPLOAD_DIRECTORY=uploads
TEMP_DIRECTORY=temp
REPORT_DIRECTORY=reports
YARA_RULES_DIRECTORY=yara_rules
LOG_DIRECTORY=logs

