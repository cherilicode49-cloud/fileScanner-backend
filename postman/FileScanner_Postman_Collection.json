          "raw": "{\n    \"url\": \"http://127.0.0.1:8000/api/health\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/scan/url",
          "host": ["{{base_url}}"],
          "path": ["api", "scan", "url"]
        },
        "description": "Tests SSRF protection by attempting to scan localhost / loopback address. Must be blocked immediately."
